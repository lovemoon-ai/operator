# Public ingest URL used by the /connect QR codes. Set this in production
# when the public upload origin is fixed or differs from the page origin.
# Leave unset to auto-detect:
#   - public domain/proxy request: use that same origin;
#   - localhost/private LAN request: enumerate LAN IPv4 addresses.
#
# If the web app is not served on port 80/443, include the actual port, e.g.
# OPERATOR_INGEST_URL=http://192.168.1.23:3001/api/ingest
