[Unit]
Description=Operator Station web service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/evophys/code/operator-github/web/app
EnvironmentFile=/home/evophys/.config/operator-station/station.env
ExecStart=/usr/bin/node ../node_modules/tsx/dist/cli.mjs server.ts
Restart=always
RestartSec=3
TimeoutStopSec=20
KillMode=mixed
LimitNOFILE=65536

[Install]
WantedBy=default.target
