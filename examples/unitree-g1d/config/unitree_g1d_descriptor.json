{
  "descriptor_version": 2,
  "execution": {
    "kind": "outside",
    "environment": "real"
  },
  "device": {
    "type": "unitree_g1d",
    "name": "Unitree G1-D",
    "icon": "robot",
    "model_url": ""
  },
  "control_schema": {
    "axes": [
      {
        "name": "base_linear",
        "display": "Base Forward / Reverse",
        "range": [-1.0, 1.0],
        "default": 0.0,
        "dead_zone": 0.12
      },
      {
        "name": "base_yaw",
        "display": "Base Rotation",
        "range": [-1.0, 1.0],
        "default": 0.0,
        "dead_zone": 0.12
      },
      {
        "name": "revo1_left_grasp",
        "display": "Left Revo-1 Grasp Action",
        "range": [0.0, 1.0],
        "default": 0.0,
        "dead_zone": 0.02
      },
      {
        "name": "revo1_right_grasp",
        "display": "Right Revo-1 Grasp Action",
        "range": [0.0, 1.0],
        "default": 0.0,
        "dead_zone": 0.02
      }
    ],
    "buttons": [
      {
        "name": "arm_ready",
        "display": "Reset Arms and Hands to Ready Pose",
        "toggle": false,
        "confirm": false
      },
      {
        "name": "arm_init",
        "display": "Reset Arms and Hands to Initial Pose",
        "toggle": false,
        "confirm": false
      },
      {
        "name": "emergency_stop",
        "display": "Emergency Stop",
        "toggle": false,
        "confirm": false
      },
      {
        "name": "reset",
        "display": "Clear Software E-Stop",
        "toggle": false,
        "confirm": true
      },
      {
        "name": "left_enable",
        "display": "Left Arm Deadman",
        "toggle": false,
        "confirm": false
      },
      {
        "name": "right_enable",
        "display": "Right Arm Deadman",
        "toggle": false,
        "confirm": false
      },
      {
        "name": "left_hand_enable",
        "display": "Left Revo-1 Deadman",
        "toggle": false,
        "confirm": false
      },
      {
        "name": "right_hand_enable",
        "display": "Right Revo-1 Deadman",
        "toggle": false,
        "confirm": false
      }
    ],
    "poses": [
      {
        "name": "left_end_effector",
        "display": "Left Arm IK Target",
        "dof": 6,
        "frame": "left_wrist"
      },
      {
        "name": "right_end_effector",
        "display": "Right Arm IK Target",
        "dof": 6,
        "frame": "right_wrist"
      },
      {
        "name": "operator_frame",
        "display": "Operator Upper-Body Frame",
        "dof": 6,
        "frame": "head"
      }
    ]
  },
  "input_mapping": [
    {
      "source": "left_joystick_y",
      "target": "base_linear",
      "scale": 1.0,
      "invert": false,
      "offset": 0.0,
      "mode": "absolute"
    },
    {
      "source": "right_joystick_x",
      "target": "base_yaw",
      "scale": 1.0,
      "invert": true,
      "offset": 0.0,
      "mode": "absolute"
    },
    {
      "source": "button_x",
      "target": "arm_ready",
      "scale": 1.0,
      "invert": false,
      "offset": 0.0,
      "mode": "momentary"
    },
    {
      "source": "button_y",
      "target": "arm_init",
      "scale": 1.0,
      "invert": false,
      "offset": 0.0,
      "mode": "momentary"
    },
    {
      "source": "button_b",
      "target": "emergency_stop",
      "scale": 1.0,
      "invert": false,
      "offset": 0.0,
      "mode": "momentary"
    },
    {
      "source": "button_a",
      "target": "reset",
      "scale": 1.0,
      "invert": false,
      "offset": 0.0,
      "mode": "momentary"
    },
    {
      "source": "head_pose",
      "target": "operator_frame",
      "scale": 1.0,
      "invert": false,
      "offset": 0.0,
      "mode": "absolute"
    },
    {
      "source": "left_arm_pose",
      "target": "left_end_effector",
      "scale": 1.0,
      "invert": false,
      "offset": 0.0,
      "mode": "absolute"
    },
    {
      "source": "right_arm_pose",
      "target": "right_end_effector",
      "scale": 1.0,
      "invert": false,
      "offset": 0.0,
      "mode": "absolute"
    },
    {
      "source": "left_arm_grip",
      "target": "left_enable",
      "scale": 1.0,
      "invert": false,
      "offset": 0.0,
      "mode": "momentary"
    },
    {
      "source": "right_arm_grip",
      "target": "right_enable",
      "scale": 1.0,
      "invert": false,
      "offset": 0.0,
      "mode": "momentary"
    },
    {
      "source": "left_trigger",
      "target": "revo1_left_grasp",
      "scale": 1.0,
      "invert": false,
      "offset": 0.0,
      "mode": "absolute"
    },
    {
      "source": "left_controller_active",
      "target": "left_hand_enable",
      "scale": 1.0,
      "invert": false,
      "offset": 0.0,
      "mode": "momentary"
    },
    {
      "source": "right_trigger",
      "target": "revo1_right_grasp",
      "scale": 1.0,
      "invert": false,
      "offset": 0.0,
      "mode": "absolute"
    },
    {
      "source": "right_controller_active",
      "target": "right_hand_enable",
      "scale": 1.0,
      "invert": false,
      "offset": 0.0,
      "mode": "momentary"
    }
  ],
