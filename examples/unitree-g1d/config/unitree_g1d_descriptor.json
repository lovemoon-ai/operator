{
  "descriptor_version": 2,
  "execution": {
    "kind": "outside",
    "environment": "real"
  },
  "device": {
    "type": "unitree_g1d",
    "name": "Unitree G1-D",
    "icon": "robot",
    "model_url": ""
  },
  "control_schema": {
    "axes": [
      {
        "name": "base_linear",
        "display": "Base Forward / Reverse",
        "range": [-1.0, 1.0],
        "default": 0.0,
        "dead_zone": 0.12
      },
      {
        "name": "base_yaw",
        "display": "Base Rotation",
        "range": [-1.0, 1.0],
        "default": 0.0,
        "dead_zone": 0.12
      }
    ],
    "buttons": [
      {
        "name": "lift_down",
        "display": "Lower Lift",
        "toggle": false,
        "confirm": false
      },
      {
        "name": "lift_up",
        "display": "Raise Lift",
        "toggle": false,
        "confirm": false
      },
      {
        "name": "emergency_stop",
        "display": "Emergency Stop",
        "toggle": false,
        "confirm": false
      },
      {
        "name": "reset",
        "display": "Clear Software E-Stop",
        "toggle": false,
        "confirm": true
      }
    ],
    "poses": []
  },
  "input_mapping": [
    {
      "source": "left_joystick_y",
      "target": "base_linear",
      "scale": 1.0,
      "invert": false,
      "offset": 0.0,
      "mode": "absolute"
    },
    {
      "source": "right_joystick_x",
      "target": "base_yaw",
      "scale": 1.0,
      "invert": true,
      "offset": 0.0,
      "mode": "absolute"
    },
    {
      "source": "button_x",
      "target": "lift_down",
      "scale": 1.0,
      "invert": false,
      "offset": 0.0,
      "mode": "momentary"
    },
    {
      "source": "button_y",
      "target": "lift_up",
      "scale": 1.0,
      "invert": false,
      "offset": 0.0,
      "mode": "momentary"
    },
    {
      "source": "button_b",
      "target": "emergency_stop",
      "scale": 1.0,
      "invert": false,
      "offset": 0.0,
      "mode": "momentary"
    },
    {
      "source": "button_a",
      "target": "reset",
      "scale": 1.0,
      "invert": false,
      "offset": 0.0,
      "mode": "momentary"
    }
  ],
  "telemetry_schema": {
    "values": [
      {"name": "connected", "display": "Connected", "type": "bool"},
      {"name": "motion_authorized", "display": "Motion Authorized", "type": "bool"},
      {"name": "estop_latched", "display": "Software E-Stop", "type": "bool"},
      {"name": "watchdog_active", "display": "Watchdog Active", "type": "bool"},
      {"name": "release_required", "display": "Neutral Return Required", "type": "bool"},
      {"name": "control_conflict", "display": "Control Mode Conflict", "type": "bool"},
      {"name": "control_mode", "display": "Control Mode", "type": "string"},
      {"name": "stop_reason", "display": "Stop Reason", "type": "string"},
      {"name": "backend", "display": "Backend", "type": "string"},
      {"name": "command_age_ms", "display": "Command Age", "unit": "ms", "type": "float"},
      {"name": "odom_fresh", "display": "Odometry Fresh", "type": "bool"},
      {"name": "odom_age_ms", "display": "Odometry Age", "unit": "ms", "type": "float"},
      {"name": "odom_x_m", "display": "Odometry X", "unit": "m", "type": "float"},
      {"name": "odom_y_m", "display": "Odometry Y", "unit": "m", "type": "float"},
      {"name": "odom_yaw_rad", "display": "Odometry Yaw", "unit": "rad", "type": "float"},
      {"name": "base_vx_mps", "display": "Measured Base X Velocity", "unit": "m/s", "type": "float"},
      {"name": "base_vy_mps", "display": "Measured Base Y Velocity", "unit": "m/s", "type": "float"},
      {"name": "base_wz_rad_s", "display": "Measured Base Yaw Velocity", "unit": "rad/s", "type": "float"},
      {"name": "height_fresh", "display": "Height Feedback Fresh", "type": "bool"},
      {"name": "height_age_ms", "display": "Height Feedback Age", "unit": "ms", "type": "float"},
      {"name": "height_m", "display": "Lift Height", "unit": "m", "type": "float"},
      {"name": "lowstate_fresh", "display": "Upper Body State Fresh", "type": "bool"},
      {"name": "lowstate_age_ms", "display": "Upper Body State Age", "unit": "ms", "type": "float"},
      {"name": "joint_positions_rad", "display": "Motor Positions", "unit": "rad", "type": "array", "length": 29},
      {"name": "joint_velocities_rad_s", "display": "Motor Velocities", "unit": "rad/s", "type": "array", "length": 29},
      {"name": "motor_fault_count", "display": "Upper Body Motor Fault Count", "type": "int"},
      {"name": "mode_machine", "display": "Unitree Machine Mode", "type": "int"},
      {"name": "last_base_result", "display": "Last AgvClient Move Result", "type": "int"},
      {"name": "last_height_result", "display": "Last HeightAdjust Result", "type": "int"}
    ]
  },
  "video_feeds": [],
  "input_contract": {
    "rate_hz": 72.0,
    "coordinate_space": "unitree_g1d_base",
    "channels": [
      {"name": "base_linear", "type": "axis", "frame": "left_joystick_y"},
      {"name": "base_yaw", "type": "axis", "frame": "right_joystick_x"},
      {"name": "lift_down", "type": "button", "frame": "button_x"},
      {"name": "lift_up", "type": "button", "frame": "button_y"},
      {"name": "emergency_stop", "type": "button", "frame": "button_b"},
      {"name": "reset", "type": "button", "frame": "button_a"}
    ]
  },
  "capabilities": {
    "teleop": true,
    "emergency_stop": true,
    "reset": true,
    "deadman": false,
    "mobile_base": true,
    "lift": true,
    "dual_arm": false,
    "video": false,
    "implementation_stage": "base_lift_mvp"
  },
  "safety": {
    "disconnect_action": "stop",
    "command_timeout_ms": 300,
    "limits": {
      "base_linear": [-1.0, 1.0],
      "base_yaw": [-1.0, 1.0]
    }
  }
}
