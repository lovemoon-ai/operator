  "video_feeds": [],
  "input_contract": {
    "rate_hz": 72.0,
    "coordinate_space": "unitree_g1d_base",
    "channels": [
      {"name": "base_linear", "type": "axis", "frame": "left_joystick_y"},
      {"name": "base_yaw", "type": "axis", "frame": "right_joystick_x"},
      {"name": "arm_ready", "type": "button", "frame": "button_x"},
      {"name": "arm_init", "type": "button", "frame": "button_y"},
      {"name": "emergency_stop", "type": "button", "frame": "button_b"},
      {"name": "reset", "type": "button", "frame": "button_a"},
      {"name": "left_end_effector", "type": "pose6d", "frame": "left_controller_or_wrist"},
      {"name": "right_end_effector", "type": "pose6d", "frame": "right_controller_or_wrist"},
      {"name": "operator_frame", "type": "pose6d", "frame": "head"},
      {"name": "left_enable", "type": "button", "frame": "left_grip_or_fist"},
      {"name": "right_enable", "type": "button", "frame": "right_grip_or_fist"},
      {"name": "revo1_left_grasp", "type": "axis", "frame": "left_trigger"},
      {"name": "revo1_right_grasp", "type": "axis", "frame": "right_trigger"},
      {"name": "left_hand_enable", "type": "button", "frame": "left_controller_active"},
      {"name": "right_hand_enable", "type": "button", "frame": "right_controller_active"}
    ]
  },
  "capabilities": {
    "teleop": true,
    "emergency_stop": true,
    "reset": true,
    "mobile_base": true,
    "lift": true,
    "deadman": true,
    "dual_arm": true,
    "dexterous_hands": true,
    "video": false,
    "implementation_stage": "base_lift_dual_arm_ik_revo1_fixed_grasp"
  },
  "safety": {
    "disconnect_action": "stop",
    "command_timeout_ms": 750,
    "limits": {
      "base_linear": [-1.0, 1.0],
      "base_yaw": [-1.0, 1.0],
      "revo1_left_grasp": [0.0, 1.0],
      "revo1_right_grasp": [0.0, 1.0]
    }
  }
