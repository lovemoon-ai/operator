SHELL := /bin/bash
.SHELLFLAGS := -e -o pipefail -c
.ONESHELL:

ROOT := /home/unitree/operator
ADAPTER_BIN := $(ROOT)/examples/unitree-g1d/build-20260915/operator-g1d-client
BRIDGE_BIN := $(ROOT)/bin/xr-bridge
DESCRIPTOR := $(ROOT)/examples/unitree-g1d/config/unitree_g1d_descriptor.json
BLUEPRINT := $(ROOT)/examples/unitree-g1d/config/unitree_g1d_blueprint.json
BRIDGE_CONFIG := $(ROOT)/examples/unitree-g1d/config/unitree_g1d_bridge.yaml
LOG_DIR := $(ROOT)/logs
RUN_DIR := $(ROOT)/run
ADAPTER_PID := $(RUN_DIR)/g1d-adapter.pid
BRIDGE_PID := $(RUN_DIR)/xr-bridge.pid
SOCKET := /tmp/operator-g1d.sock
ALLOW_MOTION ?= 1
MAX_BASE_VX ?= 0.12
MOTION_ARG = $(if $(filter 1 true yes,$(ALLOW_MOTION)),--allow-motion,)

.PHONY: adapter bridge start start-readonly stop status

adapter:
	@cd $(ROOT)
	exec $(ADAPTER_BIN) \
		$(MOTION_ARG) \
		--backend unitree \
		--listen uds:$(SOCKET) \
		--network-interface eth0 \
		--domain 0 \
		--max-base-vx $(MAX_BASE_VX) \
		--descriptor $(DESCRIPTOR) \
		--blueprint $(BLUEPRINT)

bridge:
	@cd $(ROOT)
	exec env RUST_LOG=xr_bridge=info $(BRIDGE_BIN) --config $(BRIDGE_CONFIG)

start:
	@printf 'starting G1-D services (allow_motion=%s)\n' '$(ALLOW_MOTION)'
	$(MAKE) --no-print-directory stop
	mkdir -p $(LOG_DIR) $(RUN_DIR)
	cd $(ROOT)
	nohup $(ADAPTER_BIN) \
		$(MOTION_ARG) \
		--backend unitree \
		--listen uds:$(SOCKET) \
		--network-interface eth0 \
		--domain 0 \
		--max-base-vx $(MAX_BASE_VX) \
		--descriptor $(DESCRIPTOR) \
		--blueprint $(BLUEPRINT) \
		> $(LOG_DIR)/g1d-adapter.log 2>&1 </dev/null &
	echo $$! > $(ADAPTER_PID)
	for attempt in $$(seq 1 100); do
		test -S $(SOCKET) && break
		kill -0 "$$(cat $(ADAPTER_PID))" 2>/dev/null || break
		sleep 0.1
	done
	if ! test -S $(SOCKET) || ! kill -0 "$$(cat $(ADAPTER_PID))" 2>/dev/null; then
		echo "adapter failed to start" >&2
		tail -n 40 $(LOG_DIR)/g1d-adapter.log >&2 || true
		exit 1
	fi
	nohup env RUST_LOG=xr_bridge=info $(BRIDGE_BIN) --config $(BRIDGE_CONFIG) \
		> $(LOG_DIR)/xr-bridge.log 2>&1 </dev/null &
	echo $$! > $(BRIDGE_PID)
	for attempt in $$(seq 1 100); do
		ss -lnt | grep -q ':63901 ' \
			&& ss -lnt | grep -q ':63903 ' \
			&& ss -lnt | grep -q ':12345 ' \
			&& ss -lnu | grep -q ':12345 ' \
			&& break
		kill -0 "$$(cat $(BRIDGE_PID))" 2>/dev/null || break
		sleep 0.1
	done
	if ! kill -0 "$$(cat $(BRIDGE_PID))" 2>/dev/null \
			|| ! ss -lnt | grep -q ':63901 ' \
			|| ! ss -lnt | grep -q ':63903 ' \
			|| ! ss -lnt | grep -q ':12345 ' \
			|| ! ss -lnu | grep -q ':12345 '; then
		echo "xr-bridge failed to start" >&2
		tail -n 60 $(LOG_DIR)/xr-bridge.log >&2 || true
		$(MAKE) --no-print-directory stop
		exit 1
	fi
	$(MAKE) --no-print-directory status

start-readonly:
	@$(MAKE) --no-print-directory start ALLOW_MOTION=0

stop:
	@mkdir -p $(RUN_DIR)
	for pid_file in $(BRIDGE_PID) $(ADAPTER_PID); do
		if test -s "$$pid_file"; then
			pid="$$(cat "$$pid_file")"
			kill -TERM "$$pid" 2>/dev/null || true
		fi
	done
	for pid in $$(ps -eo pid=,args= | awk \
		'$$2 == "$(ADAPTER_BIN)" || $$2 == "examples/unitree-g1d/build-20260915/operator-g1d-client" || $$2 == "$(BRIDGE_BIN)" {print $$1}'); do
		kill -TERM "$$pid" 2>/dev/null || true
	done
	for attempt in $$(seq 1 80); do
		remaining="$$(ps -eo pid=,args= | awk \
			'$$2 == "$(ADAPTER_BIN)" || $$2 == "examples/unitree-g1d/build-20260915/operator-g1d-client" || $$2 == "$(BRIDGE_BIN)" {print $$1}')"
		test -z "$$remaining" && break
		sleep 0.1
	done
	for pid in $$(ps -eo pid=,args= | awk \
		'$$2 == "$(ADAPTER_BIN)" || $$2 == "examples/unitree-g1d/build-20260915/operator-g1d-client" || $$2 == "$(BRIDGE_BIN)" {print $$1}'); do
		kill -KILL "$$pid" 2>/dev/null || true
	done
	unlink $(ADAPTER_PID) 2>/dev/null || true
	unlink $(BRIDGE_PID) 2>/dev/null || true
	unlink $(SOCKET) 2>/dev/null || true

status:
	@printf 'adapter: '
	if test -s $(ADAPTER_PID) && kill -0 "$$(cat $(ADAPTER_PID))" 2>/dev/null; then
		printf 'running pid=%s\n' "$$(cat $(ADAPTER_PID))"
	else
		printf 'stopped\n'
	fi
	printf 'xr-bridge: '
	if test -s $(BRIDGE_PID) && kill -0 "$$(cat $(BRIDGE_PID))" 2>/dev/null; then
		printf 'running pid=%s\n' "$$(cat $(BRIDGE_PID))"
	else
		printf 'stopped\n'
	fi
	ss -lntup | grep -E '(:63901|:63903|:12345)' || true
