diff --git a/src/core/teleop_session_manager_tests/python/test_teleop_session.py b/src/core/teleop_session_manager_tests/python/test_teleop_session.py
index 8a1f657..f9bd124 100644
--- a/src/core/teleop_session_manager_tests/python/test_teleop_session.py
+++ b/src/core/teleop_session_manager_tests/python/test_teleop_session.py
@@ -3053,5 +3053,60 @@ class TestOutputSinks:
             )
 
 
+class TestExternalMode:
+    """Headless caller-owned input lifecycle."""
+
+    def test_external_mode_skips_openxr_and_deviceio(self):
+        ext = MockExternalRetargeter("operator_head")
+        pipeline = MockPipeline(leaf_nodes=[ext], call_result={"action": "ok"})
+        config = TeleopSessionConfig(
+            app_name="operator",
+            pipeline=pipeline,
+            mode=SessionMode.EXTERNAL,
+            verbose=False,
+        )
+        external_data = {"operator_head": {"external_data": MagicMock()}}
+
+        with (
+            patch("isaacteleop.oxr.OpenXRSession") as openxr_session,
+            patch("isaacteleop.deviceio.DeviceIOSession.run") as deviceio_run,
+        ):
+            with TeleopSession(config) as session:
+                result = session.step(external_inputs=external_data)
+
+        assert result == {"action": "ok"}
+        assert set(pipeline.last_inputs) == {"operator_head"}
+        openxr_session.assert_not_called()
+        deviceio_run.assert_not_called()
+
+    def test_external_mode_rejects_deviceio_sources(self):
+        source = MockHeadSource()
+        config = TeleopSessionConfig(
+            app_name="operator",
+            pipeline=MockPipeline(leaf_nodes=[source]),
+            mode=SessionMode.EXTERNAL,
+        )
+
+        with pytest.raises(ValueError, match="cannot contain DeviceIO sources"):
+            TeleopSession(config)
+
+    @pytest.mark.parametrize(
+        "kwargs, message",
+        [
+            ({"trackers": [object()]}, "trackers"),
+            ({"oxr_handles": MockOpenXRHandles()}, "oxr_handles"),
+            ({"mcap_config": MagicMock()}, "mcap_config"),
+        ],
+    )
+    def test_external_mode_rejects_deviceio_configuration(self, kwargs, message):
+        with pytest.raises(ValueError, match=message):
+            TeleopSessionConfig(
+                app_name="operator",
+                pipeline=MockPipeline(),
+                mode=SessionMode.EXTERNAL,
+                **kwargs,
+            )
+
+
 if __name__ == "__main__":
     pytest.main([__file__, "-v"])
