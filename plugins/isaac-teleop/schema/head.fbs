include "pose.fbs";
include "timestamp.fbs";

namespace core;

table HeadPose {
    pose: Pose (id: 0);
    is_valid: bool (id: 1);
}

table HeadPoseTracked {
    data: HeadPose (id: 0);
}

table HeadPoseRecord {
    data: HeadPose (id: 0);
    timestamp: DeviceDataTimestamp (id: 1);
}

root_type HeadPoseRecord;
