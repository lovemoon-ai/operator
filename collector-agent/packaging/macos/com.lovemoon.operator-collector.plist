<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lovemoon.operator-collector</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/operator-collector</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OPERATOR_SERVER_URL</key>
    <string>http://127.0.0.1:6153</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/operator-collector.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/operator-collector.error.log</string>
</dict>
</plist>
