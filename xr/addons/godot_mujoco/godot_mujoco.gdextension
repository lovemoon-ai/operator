; Godot MuJoCo native runtime bridge. Android-only for RFC 003 standalone XR.

[configuration]
entry_symbol = "godot_mujoco_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]
android.debug.arm64 = "res://addons/godot_mujoco/bin/libgodot_mujoco.so"
android.release.arm64 = "res://addons/godot_mujoco/bin/libgodot_mujoco.so"

[dependencies]
android.debug.arm64 = { "res://addons/godot_mujoco/bin/libmujoco.so" : "" }
android.release.arm64 = { "res://addons/godot_mujoco/bin/libmujoco.so" : "" }
