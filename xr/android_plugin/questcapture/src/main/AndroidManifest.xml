<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="horizonos.permission.HEADSET_CAMERA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- v3 spatial audio capture: AudioCapture opens a MediaRecorder.AudioSource.MIC
         stream when the host session enables record_audio. The Godot export
         preset also flips permissions/record_audio=true so the merged
         manifest carries this through to the final APK. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Meta Quest body tracking: required for OpenXR XR_FB_body_tracking
         (upper-body, 70 joints) and XR_META_body_tracking_full_body (adds
         IK-inferred lower body for 84 joints total). The export preset
         flips meta_xr_features/body_tracking=1 so the Godot Meta XR loader
         requests both extensions when the runtime supports them; this
         permission is what unlocks the actual body samples in the headset.

         The Meta runtime explicitly checks for the matching uses-feature
         tag at xrEnumerateInstanceExtensionProperties time and will skip
         XR_FB_body_tracking with this exact logcat warning if the feature
         is missing:
           "xrEnumerateInstanceExtensionProperties: skipping extension
            `XR_FB_body_tracking` due to: missing uses-feature string
            `com.oculus.software.body_tracking` from AndroidManifest"
         The godot-openxr-meta vendor AAR is supposed to inject this tag
         when meta_xr_features/body_tracking >= 1, but in Godot 4.5 +
         current vendor AAR the injection does not actually reach the
         merged manifest — see the logcat above. We declare it ourselves so
         the merge step picks it up regardless of vendor-side handling.
         required="false" so non-Quest providers (PICO, future) still
         install the same APK. -->
    <uses-permission android:name="com.oculus.permission.BODY_TRACKING" />
    <uses-feature android:name="com.oculus.software.body_tracking" android:required="false" />

    <application>
        <meta-data
            android:name="org.godotengine.plugin.v2.QuestCapturePlugin"
            android:value="com.spatialmp4.questcapture.QuestCapturePlugin" />
    </application>
</manifest>
