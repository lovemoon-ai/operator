<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
        Meta Horizon OS gates Camera2 passthrough behind HEADSET_CAMERA.
        Pico QR scanning sources frames from XR_PICO_camera_image; declare
        the Pico camera-image entitlements here, but only dangerous runtime
        permissions are requested by QRScannerPlugin.kt.
    -->
    <uses-permission android:name="horizonos.permission.HEADSET_CAMERA" />
    <uses-permission android:name="com.pico.permission.CAMERA_DATA" />
    <uses-permission android:name="com.picovr.permission.CAMERA" />

    <application>
        <meta-data
            android:name="org.godotengine.plugin.v2.QRScannerPlugin"
            android:value="com.lovemoon.qrscanner.QRScannerPlugin" />
    </application>
</manifest>
