<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="com.picovr.permission.HEAD_TRACKER" />
    <uses-permission android:name="com.pico.permission.CAMERA_DATA" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="true" />

    <application>
        <meta-data
            android:name="org.godotengine.plugin.v2.PicoCapturePlugin"
            android:value="com.spatialmp4.picocapture.PicoCapturePlugin" />
        <meta-data
            android:name="pico.enterprise.see_through_camera"
            android:value="1" />
    </application>
</manifest>
