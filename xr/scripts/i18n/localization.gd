var current_locale: String = FALLBACK_LOCALE


func _ready() -> void:
	_register_translations()
	apply_system_locale()


func apply_system_locale() -> void:
	current_locale = choose_supported_locale(OS.get_locale())
	TranslationServer.set_locale(current_locale)
	print("[Localization] System locale %s -> %s" % [OS.get_locale(), current_locale])


func choose_supported_locale(system_locale: String) -> String:
	var normalized := system_locale.strip_edges().to_lower().replace("-", "_")
	if normalized.begins_with("zh"):
		return "zh"
	return FALLBACK_LOCALE


func _register_translations() -> void:
	for locale in SUPPORTED_LOCALES:
		if not MESSAGES.has(locale):
			continue
		var translation := Translation.new()
		translation.locale = locale
		var messages: Dictionary = MESSAGES[locale]
		for key in messages:
			translation.add_message(StringName(key), String(messages[key]))
		TranslationServer.add_translation(translation)
