<!--
  SO-101 pick-and-place scene.

  Builds on the official mujoco_menagerie SO-101 model and adds:
    - a wooden table (the arm sits on it)
    - a red 4 cm cube placed in front of the gripper
    - a third-person side camera ("side_cam")
    - the wrist camera ("wrist_cam") is already declared in so101.xml

  World layout:
    - The arm's base is at world origin (0, 0, 0).
    - The table top is at z = 0 (the arm is mounted to it).
    - The floor (visual ground plane) is below the table at z = -0.75.
-->
<mujoco model="so101_pickplace_scene">
  <include file="so101.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-25" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <!-- sky / ground -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>

    <!-- table top: light wood look -->
    <texture type="2d" name="wood" builtin="flat" rgb1="0.78 0.62 0.42"
             width="64" height="64"/>
    <material name="table_top_mat" texture="wood" rgba="0.78 0.62 0.42 1"
              specular="0.2" shininess="0.3" reflectance="0.05"/>
    <material name="table_leg_mat" rgba="0.25 0.18 0.12 1"
              specular="0.1" shininess="0.2"/>

    <!-- red cube material -->
    <material name="red_cube_mat" rgba="0.85 0.10 0.10 1"
              specular="0.3" shininess="0.4"/>
  </asset>

  <worldbody>
    <!-- Lighting -->
    <light pos="0.0 0.0 2.5" dir="0 0 -1" directional="true"
           diffuse="0.9 0.9 0.9" specular="0.1 0.1 0.1"/>
    <light pos="0.5 0.5 1.5" dir="-0.3 -0.3 -1" diffuse="0.4 0.4 0.4"/>

    <!-- Floor far below the table for visual reference -->
    <geom name="floor" size="0 0 0.05" pos="0 0 -0.75" type="plane"
          material="groundplane"/>

    <!-- ===================== TABLE ===================== -->
    <!-- Top: 1.0 m x 0.7 m, 4 cm thick. Top face at z = 0. -->
    <body name="table" pos="0.20 0 -0.02">
      <geom name="table_top" type="box" size="0.5 0.35 0.02"
            material="table_top_mat" friction="1.0 0.005 0.0001"
            contype="1" conaffinity="1"/>
      <!-- Four legs, 0.71 m tall, going down to floor (z = -0.75). -->
      <geom name="leg_fl" type="box" size="0.02 0.02 0.365"
            pos=" 0.46  0.31 -0.385" material="table_leg_mat"/>
      <geom name="leg_fr" type="box" size="0.02 0.02 0.365"
            pos=" 0.46 -0.31 -0.385" material="table_leg_mat"/>
      <geom name="leg_bl" type="box" size="0.02 0.02 0.365"
            pos="-0.46  0.31 -0.385" material="table_leg_mat"/>
      <geom name="leg_br" type="box" size="0.02 0.02 0.365"
            pos="-0.46 -0.31 -0.385" material="table_leg_mat"/>
    </body>

    <!-- ===================== RED CUBE ===================== -->
    <!-- Free body so it can be picked up. 3 cm cube, sitting on table.
         Placed within easy reach of the arm so a top-down grasp is feasible. -->
    <body name="red_cube" pos="0.24 0.02 0.015">
      <freejoint name="red_cube_freejoint"/>
      <inertial pos="0 0 0" mass="0.03"
                diaginertia="4.5e-6 4.5e-6 4.5e-6"/>
      <geom name="red_cube_geom" type="box" size="0.015 0.015 0.015"
            material="red_cube_mat"
            friction="2.0 0.02 0.002"
            contype="1" conaffinity="1" condim="6"
            solref="0.005 1" priority="1"/>
    </body>

    <!-- ===================== THIRD-PERSON SIDE CAMERA =====================
         Placed on the +Y side of the table, "targetbody" auto-aims at the cube
         so it stays on the action even if you re-arrange the scene. -->
    <camera name="side_cam" mode="targetbody" target="red_cube"
            pos="0.25 0.75 0.45" fovy="55"/>

    <!-- Optional second view from the front of the table. -->
    <camera name="front_cam" mode="targetbody" target="red_cube"
            pos="0.85 0.0 0.40" fovy="50"/>
  </worldbody>

  <keyframe>
    <!-- "home" pose: arm slightly raised, gripper open, cube on table. -->
    <key name="home"
         qpos="0 -1.2 1.2 0.0 0.0 0.5
               0.24 0.02 0.015 1 0 0 0"
         ctrl="0 -1.2 1.2 0.0 0.0 0.5"/>
  </keyframe>
</mujoco>
